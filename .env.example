# Cấu hình Supabase (Public Client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email quản trị viên chính (Master Admin)
# Trên Database, Master Admin được lưu mã hoá bảo mật trong Supabase Vault ('master_admin_email')
VITE_MASTER_ADMIN_EMAIL=

# Đuôi email công ty cho Hangout / Google Chat
VITE_COMPANY_MAIL_DOMAIN=

# Link Google Chat
VITE_GOOGLE_CHAT_URL=https://chat.google.com/
